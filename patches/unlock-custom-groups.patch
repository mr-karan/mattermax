+func TestCustomGroupsWithoutLicense(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+	th.App.Srv().SetLicense(nil)
+
+	group, response, err := th.Client.CreateGroup(context.Background(), &model.Group{
+		DisplayName:    "dn_" + model.NewId(),
+		Name:           new("name" + model.NewId()),
+		Source:         model.GroupSourceCustom,
+		AllowReference: true,
+	})
+	require.NoError(t, err)
+	CheckCreatedStatus(t, response)
+
+	_, _, err = th.Client.GetGroup(context.Background(), group.Id, "")
+	require.NoError(t, err)
+
+	newDisplayName := "dn_" + model.NewId()
+	patched, _, err := th.Client.PatchGroup(context.Background(), group.Id, &model.GroupPatch{DisplayName: &newDisplayName})
+	require.NoError(t, err)
+	assert.Equal(t, newDisplayName, patched.DisplayName)
+
+	_, _, err = th.Client.UpsertGroupMembers(context.Background(), group.Id, &model.GroupModifyMembers{UserIds: []string{th.BasicUser2.Id}})
+	require.NoError(t, err)
+
+	members, _, err := th.Client.GetGroupMembers(context.Background(), group.Id)
+	require.NoError(t, err)
+	assert.Equal(t, 1, members.Count)
+
+	groups, _, err := th.SystemAdminClient.GetGroupsByNames(context.Background(), []string{*group.Name, *th.Group.Name})
+	require.NoError(t, err)
+	require.Len(t, groups, 1)
+	assert.Equal(t, group.Id, groups[0].Id)
+
+	groups, _, err = th.SystemAdminClient.GetGroups(context.Background(), model.GroupSearchOpts{})
+	require.NoError(t, err)
+	require.Len(t, groups, 1)
+	assert.Equal(t, group.Id, groups[0].Id)
+
+	_, _, err = th.Client.DeleteGroupMembers(context.Background(), group.Id, &model.GroupModifyMembers{UserIds: []string{th.BasicUser2.Id}})
+	require.NoError(t, err)
+
+	_, _, err = th.Client.DeleteGroup(context.Background(), group.Id)
+	require.NoError(t, err)
+
+	_, _, err = th.Client.RestoreGroup(context.Background(), group.Id, "")
+	require.NoError(t, err)
+
+	th.App.UpdateConfig(func(cfg *model.Config) { *cfg.ServiceSettings.EnableCustomGroups = false })
+	_, response, err = th.Client.CreateGroup(context.Background(), &model.Group{
+		DisplayName:    "dn_" + model.NewId(),
+		Name:           new("name" + model.NewId()),
+		Source:         model.GroupSourceCustom,
+		AllowReference: true,
+	})
+	require.Error(t, err)
+	CheckBadRequestStatus(t, response)
+}

         const enabledButton = screen.getByRole('button', {name: /Create account/i});
         expect(enabledButton).not.toBeDisabled();
     });
+
+    it('should not ask for agreement when no policy links are configured', async () => {
+        mockConfig.TermsOfServiceLink = '';
+        mockConfig.PrivacyPolicyLink = '';
+
+        renderWithContext(<Signup/>, mockState);
+
+        expect(screen.queryByRole('checkbox', {name: /terms and privacy policy checkbox/i})).not.toBeInTheDocument();
+
+        await userEvent.type(screen.getByLabelText('Email address'), 'test@example.com');
+        await userEvent.type(screen.getByLabelText('Choose a Username'), 'testuser');
+        await userEvent.type(screen.getByLabelText('Choose a Password'), 'ValidPassword123!');
+
+        expect(screen.getByRole('button', {name: /Create account/i})).not.toBeDisabled();
+    });
+
+    it('should name only the configured policy link', () => {
+        mockConfig.TermsOfServiceLink = '';
+
+        const {container: signupContainer} = renderWithContext(<Signup/>, mockState);
+
+        expect(signupContainer).toHaveTextContent('I agree to the Privacy Policy');
+        expect(signupContainer).not.toHaveTextContent('Acceptable Use Policy');
+    });
 });

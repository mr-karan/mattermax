 server/public/model/config_test.go            | 18 +++++
 .../src/components/signup/signup.test.tsx     | 26 +++++++
 .../channels/src/components/signup/signup.tsx | 74 +++++++++++--------
 webapp/channels/src/i18n/en.json              |  8 ++
 5 files changed, 98 insertions(+), 32 deletions(-)

diff --git a/server/public/model/config.go b/server/public/model/config.go
index 2d79070a18ec..a80835f1abd8 100644
--- a/server/public/model/config.go
+++ b/server/public/model/config.go
@@ -2402,8 +2402,10 @@ type SupportSettings struct {
 }
 
 func (s *SupportSettings) SetDefaults() {
+	// Mattermax: a blank or unsafe link is cleared, as for PrivacyPolicyLink,
+	// instead of being reset to the default terms of use link.
 	if !isSafeLink(s.TermsOfServiceLink) {
-		*s.TermsOfServiceLink = SupportSettingsDefaultTermsOfServiceLink
+		*s.TermsOfServiceLink = ""
 	}
 
 	if s.TermsOfServiceLink == nil {
diff --git a/server/public/model/config_test.go b/server/public/model/config_test.go
index 52b7417302dd..63bd483b5f85 100644
--- a/server/public/model/config_test.go
+++ b/server/public/model/config_test.go
@@ -710,6 +710,24 @@ func TestConfigDefaultFileSettingsDirectory(t *testing.T) {
 	require.Equal(t, *c1.FileSettings.Directory, "./data/")
 }
 
+func TestConfigSupportSettingsPolicyLinks(t *testing.T) {
+	t.Run("defaults", func(t *testing.T) {
+		c := Config{}
+		c.SetDefaults()
+		require.Equal(t, SupportSettingsDefaultTermsOfServiceLink, *c.SupportSettings.TermsOfServiceLink)
+		require.Equal(t, SupportSettingsDefaultPrivacyPolicyLink, *c.SupportSettings.PrivacyPolicyLink)
+	})
+
+	for name, link := range map[string]string{"blank": "", "unsafe": "javascript:alert(1)"} {
+		t.Run(name, func(t *testing.T) {
+			c := Config{SupportSettings: SupportSettings{TermsOfServiceLink: new(link), PrivacyPolicyLink: new(link)}}
+			c.SetDefaults()
+			require.Equal(t, "", *c.SupportSettings.TermsOfServiceLink)
+			require.Equal(t, "", *c.SupportSettings.PrivacyPolicyLink)
+		})
+	}
+}
+
 func TestConfigDefaultEmailNotificationContentsType(t *testing.T) {
 	c1 := Config{}
 	c1.SetDefaults()

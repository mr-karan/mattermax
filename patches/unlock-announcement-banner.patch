+        it('should show the announcement banner page without a license', () => {
+            const state = {plugins: {adminConsoleReducers: {}}} as GlobalState;
+            const banner = getAdminDefinition(state).site.subsections.announcement_banner;
+            const isHidden = banner.isHidden as Exclude<Check, boolean>;
+            const consoleAccess = {
+                read: {[RESOURCE_KEYS.SITE.ANNOUNCEMENT_BANNER]: true},
+                write: {[RESOURCE_KEYS.SITE.ANNOUNCEMENT_BANNER]: true},
+            };
+
+            expect(isHidden({}, {}, {}, false, consoleAccess)).toBe(false);
+            expect(isHidden({}, {}, {}, false, {read: {}, write: {}})).toBe(true);
+        });
+
         it('should allow to remove everything with a plugin', () => {
             const result = getAdminDefinition({
                 plugins: {

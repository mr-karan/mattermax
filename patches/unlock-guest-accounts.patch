+func TestGuestAccountsWithoutLicense(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+
+	_, err := th.Client.Logout(context.Background())
+	require.NoError(t, err)
+
+	require.Nil(t, th.App.Channels().License())
+	th.App.UpdateConfig(func(cfg *model.Config) {
+		*cfg.GuestAccountsSettings.Enable = true
+		*cfg.GuestAccountsSettings.EnableGuestMagicLink = true
+	})
+
+	t.Run("guest signs up with an invitation token and logs in with a password", func(t *testing.T) {
+		user := model.User{Email: th.GenerateTestEmail(), Password: model.NewTestPassword(), Username: GenerateTestUsername()}
+		token := model.NewToken(
+			model.TokenTypeGuestInvitation,
+			model.MapToJSON(map[string]string{"teamId": th.BasicTeam.Id, "channels": th.BasicChannel.Id, "email": user.Email, "senderId": th.BasicUser.Id}),
+		)
+		require.NoError(t, th.App.Srv().Store().Token().Save(token))
+
+		ruser, resp, err := th.Client.CreateUserWithToken(context.Background(), &user, token.Token)
+		require.NoError(t, err)
+		CheckCreatedStatus(t, resp)
+		require.True(t, ruser.IsGuest())
+
+		guestClient := th.CreateClient()
+		loggedIn, _, err := guestClient.Login(context.Background(), user.Email, user.Password)
+		require.NoError(t, err)
+		assert.Equal(t, ruser.Id, loggedIn.Id)
+	})
+
+	t.Run("magic link guest gets the magic link login type and logs in with the emailed token", func(t *testing.T) {
+		email := strings.ToLower(model.NewId()) + "@example.com"
+		invitationToken := model.NewToken(
+			model.TokenTypeGuestMagicLinkInvitation,
+			model.MapToJSON(map[string]string{"teamId": th.BasicTeam.Id, "channels": th.BasicChannel.Id, "email": email, "guest": "true", "senderId": th.BasicUser.Id}),
+		)
+		require.NoError(t, th.App.Srv().Store().Token().Save(invitationToken))
+		guestUser, appErr := th.App.AuthenticateUserForGuestMagicLink(th.Context, invitationToken.Token)
+		require.Nil(t, appErr)
+		require.True(t, guestUser.IsGuest())
+
+		loginType, resp, err := th.Client.LoginType(context.Background(), email)
+		require.NoError(t, err)
+		CheckOKStatus(t, resp)
+		assert.Equal(t, model.UserAuthServiceMagicLink, loginType.AuthService)
+
+		loginToken, err := th.App.Srv().Store().Token().GetTokenByTypeAndEmail(model.TokenTypeGuestMagicLink, email)
+		require.NoError(t, err)
+
+		res, err := th.Client.DoAPIPost(context.Background(), "/users/login", model.MapToJSON(map[string]string{"magic_link_token": loginToken.Token}))
+		require.NoError(t, err)
+		defer closeBody(res)
+		require.NotEmpty(t, res.Header.Get(model.HeaderToken))
+		user, _, err := model.DecodeJSONFromResponse[*model.User](res)
+		require.NoError(t, err)
+		assert.Equal(t, guestUser.Id, user.Id)
+	})
+}

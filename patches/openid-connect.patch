+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+// Package oauthopenid signs users in with any OpenID Connect provider.
+package oauthopenid
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/httpservice"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+	"github.com/mattermost/mattermost/server/v8/einterfaces"
+)
+
+const (
+	discoverySuffix   = "/.well-known/openid-configuration"
+	discoveryTTL      = time.Hour
+	discoveryTimeout  = 10 * time.Second
+	discoveryMaxBytes = 1 << 20
+
+	idTokenProp = "id_token"
+	clockSkew   = 2 * time.Minute
+)
+
+type discoveryDocument struct {
+	Issuer                string `json:"issuer"`
+	AuthorizationEndpoint string `json:"authorization_endpoint"`
+	TokenEndpoint         string `json:"token_endpoint"`
+	UserinfoEndpoint      string `json:"userinfo_endpoint"`
+}
+
+type cachedDocument struct {
+	doc       *discoveryDocument
+	fetchedAt time.Time
+}
+
+type OpenIDProvider struct {
+	mu    sync.Mutex
+	cache map[string]cachedDocument
+}
+
+type userInfo struct {
+	Sub               string `json:"sub"`
+	Email             string `json:"email"`
+	EmailVerified     any    `json:"email_verified"`
+	Name              string `json:"name"`
+	GivenName         string `json:"given_name"`
+	FamilyName        string `json:"family_name"`
+	PreferredUsername string `json:"preferred_username"`
+}
+
+type idTokenClaims struct {
+	Issuer          string   `json:"iss"`
+	Subject         string   `json:"sub"`
+	Audience        audience `json:"aud"`
+	AuthorizedParty string   `json:"azp"`
+	Expiry          float64  `json:"exp"`
+}
+
+type audience []string
+
+func (a *audience) UnmarshalJSON(b []byte) error {
+	var one string
+	if err := json.Unmarshal(b, &one); err == nil {
+		*a = audience{one}
+		return nil
+	}
+	var many []string
+	if err := json.Unmarshal(b, &many); err != nil {
+		return errors.New("aud claim is neither a string nor a list of strings")
+	}
+	*a = many
+	return nil
+}
+
+func init() {
+	einterfaces.RegisterOAuthProvider(model.ServiceOpenid, newProvider())
+}
+
+func newProvider() *OpenIDProvider {
+	return &OpenIDProvider{cache: make(map[string]cachedDocument)}
+}
+
+func (p *OpenIDProvider) GetSSOSettings(rctx request.CTX, config *model.Config, service string) (*model.SSOSettings, error) {
+	sso := config.GetSSOService(service)
+	if sso == nil {
+		return nil, fmt.Errorf("no SSO settings for service %q", service)
+	}
+
+	discoveryURL := strings.TrimSpace(model.SafeDereference(sso.DiscoveryEndpoint))
+	if discoveryURL == "" {
+		return nil, errors.New("the OpenID Connect discovery endpoint is not set")
+	}
+
+	doc, err := p.discover(rctx.Context(), config, discoveryURL)
+	if err != nil {
+		return nil, err
+	}
+
+	settings := *sso
+	settings.AuthEndpoint = new(doc.AuthorizationEndpoint)
+	settings.TokenEndpoint = new(doc.TokenEndpoint)
+	settings.UserAPIEndpoint = new(doc.UserinfoEndpoint)
+	return &settings, nil
+}
+
+func (p *OpenIDProvider) discover(ctx context.Context, config *model.Config, discoveryURL string) (*discoveryDocument, error) {
+	p.mu.Lock()
+	cached, ok := p.cache[discoveryURL]
+	p.mu.Unlock()
+	if ok && time.Since(cached.fetchedAt) < discoveryTTL {
+		return cached.doc, nil
+	}
+
+	doc, err := fetchDiscovery(ctx, config, discoveryURL)
+	if err != nil {
+		return nil, err
+	}
+
+	p.mu.Lock()
+	p.cache[discoveryURL] = cachedDocument{doc: doc, fetchedAt: time.Now()}
+	p.mu.Unlock()
+	return doc, nil
+}
+
+// GetSSOSettings loads the discovery document before every GetUserFromJSON call.
+func (p *OpenIDProvider) issuer(discoveryURL string) (string, error) {
+	p.mu.Lock()
+	cached, ok := p.cache[discoveryURL]
+	p.mu.Unlock()
+	if !ok {
+		return "", fmt.Errorf("the discovery document for %q has not been loaded", discoveryURL)
+	}
+	return cached.doc.Issuer, nil
+}
+
+type configService struct{ config *model.Config }
+
+func (c configService) Config() *model.Config { return c.config }
+
+func fetchDiscovery(ctx context.Context, config *model.Config, discoveryURL string) (*discoveryDocument, error) {
+	if err := checkEndpoint("discovery endpoint", discoveryURL); err != nil {
+		return nil, err
+	}
+
+	client := httpservice.MakeHTTPService(configService{config}).MakeClient(false)
+	client.Timeout = discoveryTimeout
+	client.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, discoveryURL, nil)
+	if err != nil {
+		return nil, fmt.Errorf("creating discovery request: %w", err)
+	}
+	req.Header.Set("Accept", "application/json")
+
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("fetching discovery document: %w", err)
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("fetching discovery document: status %d (redirects are not followed)", resp.StatusCode)
+	}
+
+	var doc discoveryDocument
+	if err := json.NewDecoder(io.LimitReader(resp.Body, discoveryMaxBytes)).Decode(&doc); err != nil {
+		return nil, fmt.Errorf("decoding discovery document: %w", err)
+	}
+
+	if err := doc.validate(discoveryURL); err != nil {
+		return nil, err
+	}
+	return &doc, nil
+}
+
+func (d *discoveryDocument) validate(discoveryURL string) error {
+	if d.Issuer == "" || strings.TrimSuffix(d.Issuer, "/")+discoverySuffix != discoveryURL {
+		return fmt.Errorf("discovery document issuer %q does not match the discovery endpoint %q", d.Issuer, discoveryURL)
+	}
+
+	endpoints := []struct{ name, value string }{
+		{"authorization_endpoint", d.AuthorizationEndpoint},
+		{"token_endpoint", d.TokenEndpoint},
+		{"userinfo_endpoint", d.UserinfoEndpoint},
+	}
+	for _, e := range endpoints {
+		if err := checkEndpoint(e.name, e.value); err != nil {
+			return err
+		}
+	}
+
+	// The login URL appends its own query string to this endpoint.
+	if strings.Contains(d.AuthorizationEndpoint, "?") {
+		return fmt.Errorf("authorization_endpoint %q has a query string, which is not supported", d.AuthorizationEndpoint)
+	}
+	return nil
+}
+
+func checkEndpoint(name, value string) error {
+	u, err := url.Parse(value)
+	if err != nil || u.Host == "" {
+		return fmt.Errorf("%s %q is not an absolute URL", name, value)
+	}
+
+	switch u.Scheme {
+	case "https":
+		return nil
+	case "http":
+		if isLoopback(u.Hostname()) {
+			return nil
+		}
+	}
+	return fmt.Errorf("%s %q must use https", name, value)
+}
+
+func isLoopback(host string) bool {
+	if host == "localhost" {
+		return true
+	}
+	ip := net.ParseIP(host)
+	return ip != nil && ip.IsLoopback()
+}
+
+func (p *OpenIDProvider) GetUserFromJSON(rctx request.CTX, data io.Reader, tokenUser *model.User, settings *model.SSOSettings) (*model.User, error) {
+	claims, err := p.validIDToken(tokenUser, settings)
+	if err != nil {
+		return nil, err
+	}
+
+	var info userInfo
+	if err := json.NewDecoder(data).Decode(&info); err != nil {
+		return nil, fmt.Errorf("decoding userinfo response: %w", err)
+	}
+
+	if err := info.validate(); err != nil {
+		return nil, err
+	}
+	if info.Sub != claims.Subject {
+		return nil, errors.New("the userinfo sub claim does not match the ID token")
+	}
+
+	return info.toUser(rctx, settings, claims.Issuer), nil
+}
+
+// The token comes straight from the token endpoint over TLS, so its signature isn't checked.
+func (p *OpenIDProvider) validIDToken(tokenUser *model.User, settings *model.SSOSettings) (*idTokenClaims, error) {
+	if tokenUser == nil || tokenUser.Props[idTokenProp] == "" {
+		return nil, errors.New("the provider returned no ID token; the scope must include openid")
+	}
+	if settings == nil {
+		return nil, errors.New("no SSO settings to validate the ID token with")
+	}
+
+	issuer, err := p.issuer(strings.TrimSpace(model.SafeDereference(settings.DiscoveryEndpoint)))
+	if err != nil {
+		return nil, err
+	}
+
+	claims, err := parseIDToken(tokenUser.Props[idTokenProp])
+	if err != nil {
+		return nil, err
+	}
+	if err := claims.validate(issuer, model.SafeDereference(settings.Id), time.Now()); err != nil {
+		return nil, err
+	}
+	return claims, nil
+}
+
+func parseIDToken(raw string) (*idTokenClaims, error) {
+	parts := strings.Split(raw, ".")
+	if len(parts) != 3 {
+		return nil, errors.New("the ID token is not a signed JWT")
+	}
+	payload, err := base64.RawURLEncoding.DecodeString(strings.TrimRight(parts[1], "="))
+	if err != nil {
+		return nil, fmt.Errorf("decoding the ID token: %w", err)
+	}
+	var claims idTokenClaims
+	if err := json.Unmarshal(payload, &claims); err != nil {
+		return nil, fmt.Errorf("decoding the ID token claims: %w", err)
+	}
+	return &claims, nil
+}
+
+func (c *idTokenClaims) validate(issuer, clientID string, now time.Time) error {
+	if c.Issuer != issuer {
+		return fmt.Errorf("the ID token issuer %q is not %q", c.Issuer, issuer)
+	}
+	if c.Subject == "" {
+		return errors.New("the ID token has no sub claim")
+	}
+	if clientID == "" || !slices.Contains(c.Audience, clientID) {
+		return errors.New("the ID token audience does not include the client ID")
+	}
+	if len(c.Audience) > 1 && c.AuthorizedParty == "" {
+		return errors.New("the ID token has several audiences but no azp claim")
+	}
+	if c.AuthorizedParty != "" && c.AuthorizedParty != clientID {
+		return errors.New("the ID token azp claim is not the client ID")
+	}
+	if c.Expiry <= 0 || now.After(time.Unix(int64(c.Expiry), 0).Add(clockSkew)) {
+		return errors.New("the ID token has expired")
+	}
+	return nil
+}
+
+func (u *userInfo) validate() error {
+	if u.Sub == "" {
+		return errors.New("userinfo response has no sub claim")
+	}
+	if u.Email == "" {
+		return errors.New("userinfo response has no email claim; request the email scope")
+	}
+	// Some providers send it as a string.
+	if u.EmailVerified != true && u.EmailVerified != "true" {
+		return errors.New("the provider has not verified the user's email address")
+	}
+	return nil
+}
+
+func (u *userInfo) toUser(rctx request.CTX, settings *model.SSOSettings, issuer string) *model.User {
+	email := strings.ToLower(u.Email)
+
+	username := strings.Split(email, "@")[0]
+	if settings != nil && model.SafeDereference(settings.UsePreferredUsername) && u.PreferredUsername != "" {
+		username = strings.Split(u.PreferredUsername, "@")[0]
+	}
+
+	firstName, lastName := u.GivenName, u.FamilyName
+	if firstName == "" && lastName == "" {
+		firstName, lastName, _ = strings.Cut(strings.TrimSpace(u.Name), " ")
+	}
+
+	return &model.User{
+		Username:  model.CleanUsername(rctx.Logger(), username),
+		Email:     email,
+		FirstName: firstName,
+		LastName:  strings.TrimSpace(lastName),
+		AuthData:  new(authData(issuer, u.Sub)),
+	}
+}
+
+// A subject is unique only within its issuer; hashed to fit AuthData.
+func authData(issuer, subject string) string {
+	pair, _ := json.Marshal([2]string{issuer, subject})
+	sum := sha256.Sum256(pair)
+	return hex.EncodeToString(sum[:])
+}
+
+// GetUserFromJSON validates the token: this method isn't given the settings it needs.
+func (p *OpenIDProvider) GetUserFromIdToken(_ request.CTX, idToken string) (*model.User, error) {
+	return &model.User{Props: model.StringMap{idTokenProp: idToken}}, nil
+}
+
+func (p *OpenIDProvider) IsSameUser(_ request.CTX, dbUser, oauthUser *model.User) bool {
+	return dbUser.AuthService == oauthUser.AuthService &&
+		model.SafeDereference(dbUser.AuthData) != "" &&
+		model.SafeDereference(dbUser.AuthData) == model.SafeDereference(oauthUser.AuthData)
+}

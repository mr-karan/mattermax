+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+package oauthopenid
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+)
+
+func newDiscoveryServer(t *testing.T, edit func(doc map[string]string)) (*httptest.Server, *atomic.Int32) {
+	t.Helper()
+	var hits atomic.Int32
+	var server *httptest.Server
+	server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != discoverySuffix {
+			http.NotFound(w, r)
+			return
+		}
+		hits.Add(1)
+		doc := map[string]string{
+			"issuer":                 server.URL,
+			"authorization_endpoint": server.URL + "/authorize",
+			"token_endpoint":         server.URL + "/token",
+			"userinfo_endpoint":      server.URL + "/userinfo",
+		}
+		if edit != nil {
+			edit(doc)
+		}
+		require.NoError(t, json.NewEncoder(w).Encode(doc))
+	}))
+	t.Cleanup(server.Close)
+	return server, &hits
+}
+
+func configWithDiscovery(discoveryURL string) *model.Config {
+	cfg := &model.Config{}
+	cfg.SetDefaults()
+	cfg.ServiceSettings.AllowedUntrustedInternalConnections = new("127.0.0.1")
+	cfg.OpenIdSettings.Enable = new(true)
+	cfg.OpenIdSettings.DiscoveryEndpoint = new(discoveryURL)
+	return cfg
+}
+
+func TestGetSSOSettings(t *testing.T) {
+	rctx := request.TestContext(t)
+
+	t.Run("fills endpoints from discovery without changing the config", func(t *testing.T) {
+		server, hits := newDiscoveryServer(t, nil)
+		cfg := configWithDiscovery(server.URL + discoverySuffix)
+		p := newProvider()
+
+		settings, err := p.GetSSOSettings(rctx, cfg, model.ServiceOpenid)
+		require.NoError(t, err)
+		assert.Equal(t, server.URL+"/authorize", *settings.AuthEndpoint)
+		assert.Equal(t, server.URL+"/token", *settings.TokenEndpoint)
+		assert.Equal(t, server.URL+"/userinfo", *settings.UserAPIEndpoint)
+		assert.Equal(t, "", *cfg.OpenIdSettings.AuthEndpoint)
+		assert.Equal(t, "", *cfg.OpenIdSettings.TokenEndpoint)
+		assert.Equal(t, "", *cfg.OpenIdSettings.UserAPIEndpoint)
+
+		_, err = p.GetSSOSettings(rctx, cfg, model.ServiceOpenid)
+		require.NoError(t, err)
+		assert.Equal(t, int32(1), hits.Load(), "discovery document should be cached")
+	})
+
+	t.Run("accepts an issuer with a trailing slash", func(t *testing.T) {
+		server, _ := newDiscoveryServer(t, func(doc map[string]string) { doc["issuer"] += "/" })
+		_, err := newProvider().GetSSOSettings(rctx, configWithDiscovery(server.URL+discoverySuffix), model.ServiceOpenid)
+		require.NoError(t, err)
+	})
+
+	t.Run("requires a discovery endpoint", func(t *testing.T) {
+		_, err := newProvider().GetSSOSettings(rctx, configWithDiscovery(""), model.ServiceOpenid)
+		require.Error(t, err)
+	})
+
+	t.Run("rejects an unknown service", func(t *testing.T) {
+		_, err := newProvider().GetSSOSettings(rctx, configWithDiscovery(""), "unknown")
+		require.Error(t, err)
+	})
+
+	t.Run("rejects plain http to a non-loopback host", func(t *testing.T) {
+		_, err := newProvider().GetSSOSettings(rctx, configWithDiscovery("http://idp.example.com"+discoverySuffix), model.ServiceOpenid)
+		require.ErrorContains(t, err, "must use https")
+	})
+
+	t.Run("blocks internal addresses not in AllowedUntrustedInternalConnections", func(t *testing.T) {
+		server, hits := newDiscoveryServer(t, nil)
+		cfg := configWithDiscovery(server.URL + discoverySuffix)
+		cfg.ServiceSettings.AllowedUntrustedInternalConnections = new("")
+		_, err := newProvider().GetSSOSettings(rctx, cfg, model.ServiceOpenid)
+		require.Error(t, err)
+		assert.Equal(t, int32(0), hits.Load())
+	})
+
+	t.Run("does not follow redirects", func(t *testing.T) {
+		target, hits := newDiscoveryServer(t, nil)
+		redirect := httptest.NewServer(http.RedirectHandler(target.URL+discoverySuffix, http.StatusFound))
+		t.Cleanup(redirect.Close)
+		_, err := newProvider().GetSSOSettings(rctx, configWithDiscovery(redirect.URL+discoverySuffix), model.ServiceOpenid)
+		require.ErrorContains(t, err, "status 302")
+		assert.Equal(t, int32(0), hits.Load())
+	})
+
+	t.Run("does not cache a failed discovery", func(t *testing.T) {
+		server, hits := newDiscoveryServer(t, func(doc map[string]string) { doc["issuer"] = "https://other.example.com" })
+		p := newProvider()
+		cfg := configWithDiscovery(server.URL + discoverySuffix)
+		_, err := p.GetSSOSettings(rctx, cfg, model.ServiceOpenid)
+		require.Error(t, err)
+		_, err = p.GetSSOSettings(rctx, cfg, model.ServiceOpenid)
+		require.Error(t, err)
+		assert.Equal(t, int32(2), hits.Load())
+	})
+
+	invalid := map[string]struct {
+		edit    func(doc map[string]string)
+		message string
+	}{
+		"issuer mismatch": {
+			edit:    func(doc map[string]string) { doc["issuer"] = "https://other.example.com" },
+			message: "does not match",
+		},
+		"missing issuer": {
+			edit:    func(doc map[string]string) { delete(doc, "issuer") },
+			message: "does not match",
+		},
+		"missing userinfo endpoint": {
+			edit:    func(doc map[string]string) { delete(doc, "userinfo_endpoint") },
+			message: "userinfo_endpoint",
+		},
+		"relative token endpoint": {
+			edit:    func(doc map[string]string) { doc["token_endpoint"] = "/token" },
+			message: "token_endpoint",
+		},
+		"insecure token endpoint": {
+			edit:    func(doc map[string]string) { doc["token_endpoint"] = "http://idp.example.com/token" },
+			message: "must use https",
+		},
+		"authorization endpoint with a query string": {
+			edit:    func(doc map[string]string) { doc["authorization_endpoint"] += "?p=policy" },
+			message: "query string",
+		},
+	}
+	for name, tc := range invalid {
+		t.Run("rejects "+name, func(t *testing.T) {
+			server, _ := newDiscoveryServer(t, tc.edit)
+			_, err := newProvider().GetSSOSettings(rctx, configWithDiscovery(server.URL+discoverySuffix), model.ServiceOpenid)
+			require.ErrorContains(t, err, tc.message)
+		})
+	}
+}
+
+const (
+	testIssuer       = "https://idp.example.com"
+	testDiscoveryURL = testIssuer + discoverySuffix
+	testClientID     = "mattermax"
+)
+
+func providerWithIssuer() *OpenIDProvider {
+	p := newProvider()
+	p.cache[testDiscoveryURL] = cachedDocument{doc: &discoveryDocument{Issuer: testIssuer}, fetchedAt: time.Now()}
+	return p
+}
+
+func testSettings() *model.SSOSettings {
+	return &model.SSOSettings{
+		Id:                   new(testClientID),
+		DiscoveryEndpoint:    new(testDiscoveryURL),
+		UsePreferredUsername: new(false),
+	}
+}
+
+func validClaims(edit func(claims map[string]any)) map[string]any {
+	claims := map[string]any{
+		"iss": testIssuer,
+		"sub": "1",
+		"aud": testClientID,
+		"exp": time.Now().Add(time.Hour).Unix(),
+		"iat": time.Now().Unix(),
+	}
+	if edit != nil {
+		edit(claims)
+	}
+	return claims
+}
+
+func tokenUser(t *testing.T, claims map[string]any) *model.User {
+	t.Helper()
+	payload, err := json.Marshal(claims)
+	require.NoError(t, err)
+	raw := "eyJhbGciOiJSUzI1NiJ9." + base64.RawURLEncoding.EncodeToString(payload) + ".c2ln"
+	user, err := newProvider().GetUserFromIdToken(request.TestContext(t), raw)
+	require.NoError(t, err)
+	return user
+}
+
+func TestGetUserFromJSON(t *testing.T) {
+	rctx := request.TestContext(t)
+	p := providerWithIssuer()
+	validToken := tokenUser(t, validClaims(nil))
+
+	t.Run("maps standard claims", func(t *testing.T) {
+		user, err := p.GetUserFromJSON(rctx, strings.NewReader(`{
+			"sub": "1",
+			"email": "Jane.Doe@Example.com",
+			"email_verified": true,
+			"name": "Jane Q. Doe",
+			"given_name": "Jane",
+			"family_name": "Doe",
+			"preferred_username": "jdoe"
+		}`), validToken, testSettings())
+		require.NoError(t, err)
+		assert.Equal(t, authData(testIssuer, "1"), *user.AuthData)
+		assert.Equal(t, "jane.doe@example.com", user.Email)
+		assert.Equal(t, "jane.doe", user.Username)
+		assert.Equal(t, "Jane", user.FirstName)
+		assert.Equal(t, "Doe", user.LastName)
+		assert.Equal(t, "", user.AuthService)
+	})
+
+	t.Run("uses preferred_username when enabled", func(t *testing.T) {
+		settings := testSettings()
+		settings.UsePreferredUsername = new(true)
+		user, err := p.GetUserFromJSON(rctx, strings.NewReader(`{"sub": "1", "email": "a@example.com", "email_verified": true, "preferred_username": "Jane.Doe@corp.example.com"}`),
+			validToken, settings)
+		require.NoError(t, err)
+		assert.Equal(t, "jane.doe", user.Username)
+	})
+
+	t.Run("splits name when given and family names are missing", func(t *testing.T) {
+		user, err := p.GetUserFromJSON(rctx, strings.NewReader(`{"sub": "1", "email": "a@example.com", "email_verified": true, "name": "Jane Q. Doe"}`), validToken, testSettings())
+		require.NoError(t, err)
+		assert.Equal(t, "Jane", user.FirstName)
+		assert.Equal(t, "Q. Doe", user.LastName)
+	})
+
+	t.Run("accepts email_verified as a string", func(t *testing.T) {
+		_, err := p.GetUserFromJSON(rctx, strings.NewReader(`{"sub": "1", "email": "a@example.com", "email_verified": "true"}`), validToken, testSettings())
+		require.NoError(t, err)
+	})
+
+	t.Run("accepts several audiences with a matching azp", func(t *testing.T) {
+		token := tokenUser(t, validClaims(func(c map[string]any) {
+			c["aud"] = []string{testClientID, "other"}
+			c["azp"] = testClientID
+		}))
+		_, err := p.GetUserFromJSON(rctx, strings.NewReader(`{"sub": "1", "email": "a@example.com", "email_verified": true}`), token, testSettings())
+		require.NoError(t, err)
+	})
+
+	t.Run("binds the account to the issuer", func(t *testing.T) {
+		assert.NotEqual(t, authData("https://a.example.com", "1"), authData("https://b.example.com", "1"))
+		assert.NotEqual(t, authData("https://a.example.com", "1"), authData("https://a.example.com", "2"))
+		assert.LessOrEqual(t, len(authData(testIssuer, strings.Repeat("x", 1000))), model.UserAuthDataMaxLength)
+	})
+
+	invalidUserInfo := map[string]string{
+		"missing sub":                   `{"email": "a@example.com", "email_verified": true}`,
+		"sub not matching the ID token": `{"sub": "2", "email": "a@example.com", "email_verified": true}`,
+		"missing email":                 `{"sub": "1", "email_verified": true}`,
+		"unverified email":              `{"sub": "1", "email": "a@example.com", "email_verified": false}`,
+		"unverified email as string":    `{"sub": "1", "email": "a@example.com", "email_verified": "false"}`,
+		"missing email_verified":        `{"sub": "1", "email": "a@example.com"}`,
+		"null email_verified":           `{"sub": "1", "email": "a@example.com", "email_verified": null}`,
+		"numeric email_verified":        `{"sub": "1", "email": "a@example.com", "email_verified": 1}`,
+		"uppercase email_verified":      `{"sub": "1", "email": "a@example.com", "email_verified": "TRUE"}`,
+		"object email_verified":         `{"sub": "1", "email": "a@example.com", "email_verified": {}}`,
+		"malformed json":                `{`,
+	}
+	for name, body := range invalidUserInfo {
+		t.Run("rejects "+name, func(t *testing.T) {
+			_, err := p.GetUserFromJSON(rctx, strings.NewReader(body), validToken, testSettings())
+			require.Error(t, err)
+		})
+	}
+
+	const validUserInfo = `{"sub": "1", "email": "a@example.com", "email_verified": true}`
+
+	t.Run("rejects a login without an ID token", func(t *testing.T) {
+		_, err := p.GetUserFromJSON(rctx, strings.NewReader(validUserInfo), nil, testSettings())
+		require.ErrorContains(t, err, "no ID token")
+	})
+
+	t.Run("rejects an ID token before discovery is loaded", func(t *testing.T) {
+		_, err := newProvider().GetUserFromJSON(rctx, strings.NewReader(validUserInfo), validToken, testSettings())
+		require.ErrorContains(t, err, "has not been loaded")
+	})
+
+	t.Run("rejects a malformed ID token", func(t *testing.T) {
+		for _, raw := range []string{"not-a-jwt", "a.b", "a.!!!.c", "a." + base64.RawURLEncoding.EncodeToString([]byte("[]")) + ".c"} {
+			token := &model.User{Props: model.StringMap{idTokenProp: raw}}
+			_, err := p.GetUserFromJSON(rctx, strings.NewReader(validUserInfo), token, testSettings())
+			require.Error(t, err, raw)
+		}
+	})
+
+	invalidClaims := map[string]func(c map[string]any){
+		"another issuer":                  func(c map[string]any) { c["iss"] = "https://other.example.com" },
+		"no issuer":                       func(c map[string]any) { delete(c, "iss") },
+		"no sub":                          func(c map[string]any) { delete(c, "sub") },
+		"another audience":                func(c map[string]any) { c["aud"] = "other" },
+		"no audience":                     func(c map[string]any) { delete(c, "aud") },
+		"several audiences without azp":   func(c map[string]any) { c["aud"] = []string{testClientID, "other"} },
+		"an azp that isn't the client ID": func(c map[string]any) { c["azp"] = "other" },
+		"an expired token":                func(c map[string]any) { c["exp"] = time.Now().Add(-time.Hour).Unix() },
+		"no expiry":                       func(c map[string]any) { delete(c, "exp") },
+	}
+	for name, edit := range invalidClaims {
+		t.Run("rejects an ID token with "+name, func(t *testing.T) {
+			_, err := p.GetUserFromJSON(rctx, strings.NewReader(validUserInfo), tokenUser(t, validClaims(edit)), testSettings())
+			require.Error(t, err)
+		})
+	}
+}
+
+func TestIsSameUser(t *testing.T) {
+	rctx := request.TestContext(t)
+	p := newProvider()
+	user := func(service, authData string) *model.User {
+		return &model.User{AuthService: service, AuthData: new(authData)}
+	}
+
+	assert.True(t, p.IsSameUser(rctx, user(model.ServiceOpenid, "1"), user(model.ServiceOpenid, "1")))
+	assert.False(t, p.IsSameUser(rctx, user(model.ServiceOpenid, "1"), user(model.ServiceOpenid, "2")))
+	assert.False(t, p.IsSameUser(rctx, user(model.ServiceGitlab, "1"), user(model.ServiceOpenid, "1")))
+	assert.False(t, p.IsSameUser(rctx, user(model.ServiceOpenid, ""), user(model.ServiceOpenid, "")))
+	assert.False(t, p.IsSameUser(rctx, &model.User{AuthService: model.ServiceOpenid}, user(model.ServiceOpenid, "1")))
+}
+
+func TestGetUserFromIdToken(t *testing.T) {
+	user, err := newProvider().GetUserFromIdToken(request.TestContext(t), "header.payload.signature")
+	require.NoError(t, err)
+	assert.Equal(t, "header.payload.signature", user.Props[idTokenProp])
+}

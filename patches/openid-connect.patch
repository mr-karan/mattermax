--- /dev/null
+++ b/server/channels/app/oauthproviders/openid/openid.go
@@ -0,0 +1,273 @@
+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+// Package oauthopenid signs users in with any OpenID Connect provider. It
+// finds the provider's endpoints with OpenID Connect Discovery and reads the
+// user from the UserInfo endpoint, which the server calls over TLS with the
+// access token it received from the token endpoint.
+package oauthopenid
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+	"github.com/mattermost/mattermost/server/v8/einterfaces"
+)
+
+const (
+	discoverySuffix   = "/.well-known/openid-configuration"
+	discoveryTTL      = time.Hour
+	discoveryTimeout  = 10 * time.Second
+	discoveryMaxBytes = 1 << 20
+)
+
+type discoveryDocument struct {
+	Issuer                string `json:"issuer"`
+	AuthorizationEndpoint string `json:"authorization_endpoint"`
+	TokenEndpoint         string `json:"token_endpoint"`
+	UserinfoEndpoint      string `json:"userinfo_endpoint"`
+}
+
+type cachedDocument struct {
+	doc       *discoveryDocument
+	fetchedAt time.Time
+}
+
+type OpenIDProvider struct {
+	client *http.Client
+
+	mu    sync.Mutex
+	cache map[string]cachedDocument
+}
+
+// userInfo holds the standard claims (OpenID Connect Core 1.0, section 5.1)
+// this provider uses.
+type userInfo struct {
+	Sub               string `json:"sub"`
+	Email             string `json:"email"`
+	EmailVerified     any    `json:"email_verified"`
+	Name              string `json:"name"`
+	GivenName         string `json:"given_name"`
+	FamilyName        string `json:"family_name"`
+	PreferredUsername string `json:"preferred_username"`
+}
+
+func init() {
+	einterfaces.RegisterOAuthProvider(model.ServiceOpenid, newProvider())
+}
+
+func newProvider() *OpenIDProvider {
+	return &OpenIDProvider{
+		client: &http.Client{Timeout: discoveryTimeout},
+		cache:  make(map[string]cachedDocument),
+	}
+}
+
+// GetSSOSettings returns a copy of the service's settings with the endpoints
+// filled in from its discovery document. The System Console clears the
+// endpoint settings and keeps only the discovery endpoint.
+func (p *OpenIDProvider) GetSSOSettings(rctx request.CTX, config *model.Config, service string) (*model.SSOSettings, error) {
+	sso := config.GetSSOService(service)
+	if sso == nil {
+		return nil, fmt.Errorf("no SSO settings for service %q", service)
+	}
+
+	discoveryURL := strings.TrimSpace(model.SafeDereference(sso.DiscoveryEndpoint))
+	if discoveryURL == "" {
+		return nil, errors.New("the OpenID Connect discovery endpoint is not set")
+	}
+
+	doc, err := p.discover(rctx.Context(), discoveryURL)
+	if err != nil {
+		return nil, err
+	}
+
+	settings := *sso
+	settings.AuthEndpoint = new(doc.AuthorizationEndpoint)
+	settings.TokenEndpoint = new(doc.TokenEndpoint)
+	settings.UserAPIEndpoint = new(doc.UserinfoEndpoint)
+	return &settings, nil
+}
+
+func (p *OpenIDProvider) discover(ctx context.Context, discoveryURL string) (*discoveryDocument, error) {
+	p.mu.Lock()
+	cached, ok := p.cache[discoveryURL]
+	p.mu.Unlock()
+	if ok && time.Since(cached.fetchedAt) < discoveryTTL {
+		return cached.doc, nil
+	}
+
+	doc, err := p.fetchDiscovery(ctx, discoveryURL)
+	if err != nil {
+		return nil, err
+	}
+
+	p.mu.Lock()
+	p.cache[discoveryURL] = cachedDocument{doc: doc, fetchedAt: time.Now()}
+	p.mu.Unlock()
+	return doc, nil
+}
+
+func (p *OpenIDProvider) fetchDiscovery(ctx context.Context, discoveryURL string) (*discoveryDocument, error) {
+	if err := checkEndpoint("discovery endpoint", discoveryURL); err != nil {
+		return nil, err
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, discoveryURL, nil)
+	if err != nil {
+		return nil, fmt.Errorf("creating discovery request: %w", err)
+	}
+	req.Header.Set("Accept", "application/json")
+
+	resp, err := p.client.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("fetching discovery document: %w", err)
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("fetching discovery document: status %d", resp.StatusCode)
+	}
+
+	var doc discoveryDocument
+	if err := json.NewDecoder(io.LimitReader(resp.Body, discoveryMaxBytes)).Decode(&doc); err != nil {
+		return nil, fmt.Errorf("decoding discovery document: %w", err)
+	}
+
+	if err := doc.validate(discoveryURL); err != nil {
+		return nil, err
+	}
+	return &doc, nil
+}
+
+// validate checks the document as OpenID Connect Discovery 1.0 section 4.3
+// requires, and that every endpoint is usable.
+func (d *discoveryDocument) validate(discoveryURL string) error {
+	if d.Issuer == "" || strings.TrimSuffix(d.Issuer, "/")+discoverySuffix != discoveryURL {
+		return fmt.Errorf("discovery document issuer %q does not match the discovery endpoint %q", d.Issuer, discoveryURL)
+	}
+
+	endpoints := []struct{ name, value string }{
+		{"authorization_endpoint", d.AuthorizationEndpoint},
+		{"token_endpoint", d.TokenEndpoint},
+		{"userinfo_endpoint", d.UserinfoEndpoint},
+	}
+	for _, e := range endpoints {
+		if err := checkEndpoint(e.name, e.value); err != nil {
+			return err
+		}
+	}
+
+	// The login URL is built by appending "?response_type=..." to this
+	// endpoint, which only works if it has no query string of its own.
+	if strings.Contains(d.AuthorizationEndpoint, "?") {
+		return fmt.Errorf("authorization_endpoint %q has a query string, which is not supported", d.AuthorizationEndpoint)
+	}
+	return nil
+}
+
+// checkEndpoint requires an absolute HTTPS URL. Plain HTTP is allowed only to
+// a loopback address, for local testing.
+func checkEndpoint(name, value string) error {
+	u, err := url.Parse(value)
+	if err != nil || u.Host == "" {
+		return fmt.Errorf("%s %q is not an absolute URL", name, value)
+	}
+
+	switch u.Scheme {
+	case "https":
+		return nil
+	case "http":
+		if isLoopback(u.Hostname()) {
+			return nil
+		}
+	}
+	return fmt.Errorf("%s %q must use https", name, value)
+}
+
+func isLoopback(host string) bool {
+	if host == "localhost" {
+		return true
+	}
+	ip := net.ParseIP(host)
+	return ip != nil && ip.IsLoopback()
+}
+
+func (p *OpenIDProvider) GetUserFromJSON(rctx request.CTX, data io.Reader, _ *model.User, settings *model.SSOSettings) (*model.User, error) {
+	var info userInfo
+	if err := json.NewDecoder(data).Decode(&info); err != nil {
+		return nil, fmt.Errorf("decoding userinfo response: %w", err)
+	}
+
+	if err := info.validate(); err != nil {
+		return nil, err
+	}
+
+	return info.toUser(rctx, settings), nil
+}
+
+func (u *userInfo) validate() error {
+	if u.Sub == "" {
+		return errors.New("userinfo response has no sub claim")
+	}
+	if len(u.Sub) > model.UserAuthDataMaxLength {
+		return fmt.Errorf("sub claim is longer than %d characters", model.UserAuthDataMaxLength)
+	}
+	if u.Email == "" {
+		return errors.New("userinfo response has no email claim; request the email scope")
+	}
+	// Some providers send email_verified as a string.
+	if u.EmailVerified == false || u.EmailVerified == "false" {
+		return errors.New("the provider has not verified the user's email address")
+	}
+	return nil
+}
+
+func (u *userInfo) toUser(rctx request.CTX, settings *model.SSOSettings) *model.User {
+	email := strings.ToLower(u.Email)
+
+	username := strings.Split(email, "@")[0]
+	if settings != nil && model.SafeDereference(settings.UsePreferredUsername) && u.PreferredUsername != "" {
+		username = strings.Split(u.PreferredUsername, "@")[0]
+	}
+
+	firstName, lastName := u.GivenName, u.FamilyName
+	if firstName == "" && lastName == "" {
+		firstName, lastName, _ = strings.Cut(strings.TrimSpace(u.Name), " ")
+	}
+
+	// AuthService is left empty: the caller sets it to the service in use.
+	return &model.User{
+		Username:  model.CleanUsername(rctx.Logger(), username),
+		Email:     email,
+		FirstName: firstName,
+		LastName:  strings.TrimSpace(lastName),
+		AuthData:  new(u.Sub),
+	}
+}
+
+// GetUserFromIdToken does not read the ID token. The user comes from the
+// UserInfo response instead, and the interface doesn't pass the client ID
+// and issuer needed to validate an ID token.
+func (p *OpenIDProvider) GetUserFromIdToken(_ request.CTX, _ string) (*model.User, error) {
+	return nil, nil
+}
+
+// IsSameUser never matches a user only by email address: an account found
+// by email is linked only if it already belongs to this service and subject.
+func (p *OpenIDProvider) IsSameUser(_ request.CTX, dbUser, oauthUser *model.User) bool {
+	return dbUser.AuthService == oauthUser.AuthService &&
+		model.SafeDereference(dbUser.AuthData) != "" &&
+		model.SafeDereference(dbUser.AuthData) == model.SafeDereference(oauthUser.AuthData)
+}
diff --git a/server/channels/app/oauthproviders/openid/openid_test.go b/server/channels/app/oauthproviders/openid/openid_test.go

@@ -0,0 +1,21 @@
+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+import type {AdminDefinition} from './types';
+
+// removeUpsellPages removes the System Console pages that only advertise paid
+// Mattermost features: every feature discovery page, and the About section,
+// whose only page is Edition and License. It changes the definition in place.
+export function removeUpsellPages(definition: AdminDefinition): AdminDefinition {
+    delete definition.about;
+
+    for (const section of Object.values(definition)) {
+        for (const [key, subsection] of Object.entries(section.subsections)) {
+            if (subsection.isDiscovery) {
+                delete section.subsections[key];
+            }
+        }
+    }
+
+    return definition;
+}

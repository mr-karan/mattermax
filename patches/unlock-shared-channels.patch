+func TestRemoteClusterPingWithoutLicense(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := setupForSharedChannels(t).InitBasic(t)
+	require.Nil(t, th.App.Srv().License())
+
+	rc, appErr := th.App.AddRemoteCluster(&model.RemoteCluster{
+		Name:        "remotecluster",
+		SiteURL:     "http://example.com",
+		Token:       model.NewId(),
+		RemoteToken: model.NewId(),
+		CreatorId:   th.SystemAdminUser.Id,
+	})
+	require.Nil(t, appErr)
+
+	ping, err := json.Marshal(model.RemoteClusterPing{SentAt: model.GetMillis()})
+	require.NoError(t, err)
+	frame, err := json.Marshal(model.RemoteClusterFrame{RemoteId: rc.RemoteId, Msg: model.NewRemoteClusterMsg("ping", ping)})
+	require.NoError(t, err)
+
+	client := th.CreateClient()
+	sendPing := func(token string) *http.Response {
+		resp, _ := client.DoAPIRequestWithHeaders(context.Background(), http.MethodPost, "/remotecluster/ping", string(frame), map[string]string{
+			model.HeaderRemoteclusterToken: token,
+			model.HeaderRemoteclusterId:    rc.RemoteId,
+		})
+		require.NotNil(t, resp)
+		defer resp.Body.Close()
+		return resp
+	}
+
+	require.Equal(t, http.StatusOK, sendPing(rc.Token).StatusCode)
+	require.Equal(t, http.StatusUnauthorized, sendPing(model.NewId()).StatusCode)
+}
